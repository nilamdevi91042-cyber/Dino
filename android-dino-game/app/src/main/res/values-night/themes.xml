<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DinoRun" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#8A98FF</item>
        <item name="colorPrimaryVariant">@color/brand_primary</item>
        <item name="colorOnPrimary">#0F1226</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#0F1226</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="Theme.DinoRun.Fullscreen" parent="Theme.DinoRun">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
